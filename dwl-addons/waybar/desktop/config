{
    "position": "top",
    "height": 50,
    "spacing": 10, 
    "modules-left": [
        "dwl/tags",
        "dwl/window#layout"
    ],
    "modules-center": [
        "dwl/window#title"
    ],
    "modules-right": [
        "battery",
        "pulseaudio",
        "tray",
        "clock"
    ],
    "dwl/tags": {
        "num-tags": 6,
        "tag-labels": ["", "󰈹", "", 4, 5, 6]
    },
    "dwl/window#layout": {
        "format": "{layout}",
        "max-length": 50,
        "tooltip": false
    }, 
    "dwl/window#title": {
        "format": "{title}",
        "max-length": 50,
        "tooltip": false
    }, 
    "pulseaudio": {
        "states": {
            "max": 100,
            "half": 50,
            "0": 0
        },
        "tooltip-format": "{volume}% ({desc})",
        "format": "{icon}{volume}",
        "format-icons": ["", "", ""],
        "format-bluetooth": "󰦢{volume}",
        "format-muted": "󰓄",
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "tray": {
        "icon-size": 35,
        "spacing": 10
    },
    "clock": {
        "format": "{:%b %d, %a %I:%M}",
        "tooltip": false
    }
}
