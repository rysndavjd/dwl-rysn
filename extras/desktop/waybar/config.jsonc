[{
	"layer": "top",	
    "output": "HDMI-A-1",
	"position": "top",
    "height": 51,
    "fixed-center": false,

    "modules-left": ["dwl/tags", "dwl/window"],
    "modules-center": ["dwl/window#title"],
    "modules-right": ["tray", "clock"],
    
	"dwl/tags": {
        "num-tags": 6,
        "tag-labels": ["", "󰈹", "", "4", "5", "6"] 
    },

    "dwl/window": {
        "format": "{layout}",
        "max-length": 5,
        "tooltip": false
    },

    "dwl/window#title": {
        "format": "{title}",
        "max-length": 50,
        "tooltip": false
    },

    // "tray": {
